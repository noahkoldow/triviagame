{
  "name": "nexus",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "pnpm --filter @nexus/mobile start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "firebase:emulators": "firebase emulators:start --only functions,firestore",
    "firebase:deploy": "pnpm --filter @nexus/functions build && firebase deploy --only firestore:rules,firestore:indexes,functions",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "~5.9.2"
  }
}
