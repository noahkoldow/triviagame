{
  "expo": {
    "name": "Nexus",
    "slug": "nexus",
    "scheme": "nexus",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070B16",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.nexus.game",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "app.nexus.game"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "000b6747-1417-4824-933e-19d62471e4e9"
      }
    },
    "owner": "noehxpo",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/000b6747-1417-4824-933e-19d62471e4e9"
    }
  }
}
